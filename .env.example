# NexLM API Configuration
NEX_API_KEY=your_nexlm_api_key_here

# Optional: Custom API base URL
# NEX_BASE_URL=

# Optional: Default model
# NEX_MODEL=nexlm

# Optional: Max tokens per response (default: 16384)
# NEX_MAX_TOKENS=16384

# Optional: Telegram bot token for /remote-control → Telegram (see README)
# TELEGRAM_BOT_TOKEN=123456:ABC...
